#!/bin/bash

# Batt
batt="$(cat /sys/class/power_supply/BAT0/capacity)"
state="$(cat /sys/class/power_supply/BAT0/status)"
time_raw="$(upower --dump | grep -m1 'time to')"

# If time_raw is empty, blank time + UNITS; otherwise parse normally
if [[ -z "$time_raw" ]]; then
    time=""
    UNITS=""
else
    time="$(echo "$time_raw" | awk '{print $4}')"
    UNITS="$(echo "$time_raw" | awk '{print $5}')"
fi

sym="%"

# Time
if [[ -n "$time" && ${#time} -gt 1 ]] ; then
    time=", $time"
fi

# Units
if [[ -n "$UNITS" ]]; then
    if [[ $UNITS == "hours" ]]; then
        UNITS="hrs"
    elif [[ $UNITS == "hour" ]]; then
        UNITS="hr"
    else
        UNITS="mins"
    fi
fi

# Charge icon
if [[ !(-d "/sys/class/power_supply/BAT0") ]] ; then
    icon1="󰂃"
    sym=""
    time=""
elif [[ $state == "Charging" ]] ; then
    icon1="󰂄"
else
    if [[ $batt -gt 98 ]] ; then
        icon1="󰁹"
    elif [[ $batt -gt 90 ]] ; then
        icon1="󰂂"
    elif [[ $batt -gt 80 ]] ; then
        icon1="󰂁"
    elif [[ $batt -gt 70 ]] ; then
        icon1="󰂀"
    elif [[ $batt -gt 60 ]] ; then
        icon1="󰁿"
    elif [[ $batt -gt 50 ]] ; then
        icon1="󰁾"
    elif [[ $batt -gt 40 ]] ; then
        icon1="󰁽"
    elif [[ $batt -gt 30 ]] ; then
        icon1="󰁼"
    elif [[ $batt -gt 20 ]] ; then
        icon1="󰁻"
    elif [[ $batt -gt 10 ]] ; then
        icon1="󰁺"
    else 
        icon1="󰂎"
    fi
fi

# Output
echo $icon1 $batt$sym$time $UNITS
