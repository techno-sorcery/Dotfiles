#!/bin/bash

# Batt
batt="$(cat /sys/class/power_supply/BAT0/capacity)"
state="$(cat /sys/class/power_supply/BAT0/status)"
time_raw="$(upower --dump | grep -m1 'time to')"
LAST_BATT_FILE="$HOME/.cache/last_batt"

# Read last battery value, default to 100 if file doesn't exist
if [ -f "$LAST_BATT_FILE" ]; then
    LAST_BATT=$(<"$LAST_BATT_FILE")
else
    LAST_BATT=100
fi

# Display low battery warning
if [ "$batt" -le 20 ] && [ "$LAST_BATT" -gt 20 ]; then
    notify-send "Low battery warning" "Consider plugging into a charger" -i battery-caution-symbolic -r 11 -t 3000 -c "power"
elif [ "$batt" -le 5 ] && [ "$LAST_BATT" -gt 5 ]; then
    notify-send "Critical battery warning" "Please plug into a charger" -i battery-action-symbolic -r 11 -t 3000 -c "power"
fi

# Cache last value
echo "$batt" > ~/.cache/last_batt

# If time_raw is empty, blank time + UNITS; otherwise parse normally
if [[ -z "$time_raw" ]]; then
    time=""
    UNITS=""
else
    time="$(echo "$time_raw" | awk '{print $4}')"
    UNITS="$(echo "$time_raw" | awk '{print $5}')"
fi

sym="%"

# Time
if [[ -n "$time" && ${#time} -gt 1 ]] ; then
    time=", $time"
fi

# Units
if [[ -n "$UNITS" ]]; then
    if [[ $UNITS == "hours" ]]; then
        UNITS="hrs"
    elif [[ $UNITS == "hour" ]]; then
        UNITS="hr"
    else
        UNITS="mins"
    fi
fi

# Charge icon
if [[ !(-d "/sys/class/power_supply/BAT0") ]] ; then
    icon1="󰂃 "
    sym=""
    time=""
elif [[ $state == "Charging" ]] ; then
    icon1="󰂄 "
else
    if [[ $batt -gt 98 ]] ; then
        icon1="󰁹 "
    elif [[ $batt -gt 90 ]] ; then
        icon1="󰂂 "
    elif [[ $batt -gt 80 ]] ; then
        icon1="󰂁 "
    elif [[ $batt -gt 70 ]] ; then
        icon1="󰂀 "
    elif [[ $batt -gt 60 ]] ; then
        icon1="󰁿 "
    elif [[ $batt -gt 50 ]] ; then
        icon1="󰁾 "
    elif [[ $batt -gt 40 ]] ; then
        icon1="󰁽 "
    elif [[ $batt -gt 30 ]] ; then
        icon1="󰁼 "
    elif [[ $batt -gt 20 ]] ; then
        icon1="󰁻 "
    elif [[ $batt -gt 10 ]] ; then
        icon1="󰁺 "
    else 
        icon1="󰂎 "
    fi
fi

# Output
echo $icon1 $batt$sym$time $UNITS
