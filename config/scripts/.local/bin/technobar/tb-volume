#!/bin/bash

# Vol
vol="$(amixer get Master | awk '/Left:/ {print substr($5, 2, length($5)-3)}' )"
power="$(amixer get Master | awk '/Left:/ {print $6}')"

if [ $power == [off] ] ; then
    icon2="󰸈 "
    vol="0"
elif [[ $vol -ge 66 ]] ; then
    icon2="󰕾 "
elif [[ $vol -ge 33 ]] ; then
    icon2="󰖀 "
else
    icon2="󰕿 "
fi

# Output
echo "$icon2 $vol%"
