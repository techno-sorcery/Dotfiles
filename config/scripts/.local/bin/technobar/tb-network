#!/bin/bash

# Mem
# ssid="$(nmcli con show | awk '/wlp4s0/ {print $1}')"
ssid="$(sudo iwgetid -r | sed 's/\(.\{5\}\).*/\1.../')"
strength="$(awk 'NR==3 {print int($3 * 100 / 70)}' /proc/net/wireless)"

if [[ ${#ssid} == 0 ]] ; then
    icon1="󰤭"
    ssid=""
elif [[ $strength -gt 75 ]] ; then
    icon1="󰤨"
elif [[ $strength -gt 50 ]] ; then
    icon1="󰤥"
elif [[ $strength -gt 25 ]] ; then
    icon1="󰤢"
else
    icon1="󰤟"
fi

# Output
echo "$icon1  $ssid"
